APP_ENV=production
FLASK_DEBUG=false
SECRET_KEY=
SESSION_COOKIE_SECURE=true
CREATE_TABLES=false
# Copy the actual Session pooler URI from Supabase > Connect (IPv4, port 5432).
# Percent-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
MURAL_LIBRARY_PATH=static/videos
MURAL_DATA_PATH=data/mural.csv
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate with getpass + werkzeug.security.generate_password_hash; never commit the result.
ADMIN_PASSWORD_HASH=
# PythonAnywhere documents the rightmost X-Forwarded-For entry as trusted.
# Only use this when all requests arrive through PythonAnywhere's load balancer.
TRUSTED_PROXY_COUNT=1
