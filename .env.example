FLASK_DEBUG=true
APP_ENV=development
SESSION_COOKIE_SECURE=false
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
# Zero on local networks; set only to the actual number of trusted reverse proxies.
TRUSTED_PROXY_COUNT=0
CREATE_TABLES=true
DATABASE_URL=sqlite:///instance/actsp.db
MURAL_LIBRARY_PATH=static/videos
MURAL_DATA_PATH=data/mural.csv
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
